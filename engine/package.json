{
  "name": "@vedicnepali/engine",
  "version": "1.1.0",
  "description": "Nepali and Sanskrit Romanized input: transliteration (Romanized Nepali, IAST, ITRANS, Harvard-Kyoto), Devanagari Unicode helpers and word suggestions",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dictionaries/ne.json": "./suggestions/data/ne.json",
    "./dictionaries/sa.json": "./suggestions/data/sa.json",
    "./schemes/*.json": "./transliteration/schemes/*.json",
    "./dictionaries/bigrams.json": "./suggestions/data/bigrams.json",
    "./keyboards/*.json": "./keyboards/*.json"
  },
  "files": [
    "dist",
    "suggestions/data",
    "transliteration/schemes",
    "keyboards"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/sushilldhakal/font-keyboard.git",
    "directory": "engine"
  },
  "scripts": {
    "gen": "node scripts/gen-schemes.mjs",
    "build": "node scripts/gen-schemes.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/gen-schemes.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/gen-schemes.mjs && vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
