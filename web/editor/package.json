{
  "name": "@nagosi/editor",
  "version": "1.0.1",
  "private": true,
  "description": "Nagosi online typing tool and font tester: one standalone HTML file with the font and engine inlined",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node scripts/build.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nagosi/engine": "workspace:*",
    "@nagosi/keyboard": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "vitest": "3.2.4",
    "typescript": "5.9.3"
  }
}
