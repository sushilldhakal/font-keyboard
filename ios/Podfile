# Handwriting (ML Kit Digital Ink, Nepali). Typing works without it.
#   cd ios && ./scripts/sync-resources.sh && xcodegen && pod install && open Nagosi.xcworkspace
platform :ios, '16.0'
use_frameworks! :linkage => :static

target 'Nagosi' do
end

target 'NagosiKeyboard' do
  pod 'GoogleMLKit/DigitalInkRecognition', '~> 7.0'
end
